{
  "openapi": "3.0.0",
  "info": {
    "title": "AJRM Marine Voyages",
    "version": "0.10.0",
    "description": "Canonical voyage recording, replay, review, observation and bundle API. Signal K authentication is required; state-changing routes require administrative access."
  },
  "paths": {
    "/status": {
      "get": { "summary": "Return recorder, replay, finalisation and storage status", "responses": { "200": { "description": "Capture status" } } }
    },
    "/voyages": {
      "get": { "summary": "List current canonical voyage bundles", "responses": { "200": { "description": "Voyage list" } } }
    },
    "/voyages/{file}/download": {
      "get": {
        "summary": "Download a voyage ZIP as a stream",
        "parameters": [{ "name": "file", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Voyage ZIP" }, "404": { "description": "Voyage not found" } }
      }
    },
    "/voyages/{file}/delete": {
      "post": {
        "summary": "Delete a voyage ZIP and any matching working directory",
        "parameters": [{ "name": "file", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Voyage deleted" }, "404": { "description": "Voyage not found" } }
      }
    },
    "/review/status": {
      "get": { "summary": "Return voyage-review capability status", "responses": { "200": { "description": "Review status" } } }
    },
    "/review/voyages": {
      "get": { "summary": "List voyage bundles for review", "responses": { "200": { "description": "Voyage list" } } }
    },
    "/review/voyages/{file}/analysis-progress": {
      "get": { "summary": "Return voyage-analysis progress", "parameters": [{ "name": "file", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Analysis progress" } } }
    },
    "/review/voyages/{file}/analyse": {
      "post": { "summary": "Analyse a voyage bundle", "parameters": [{ "name": "file", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Voyage analysis" } } }
    },
    "/review/voyages/{file}/track.gpx": {
      "get": { "summary": "Export a reviewed voyage track as GPX", "parameters": [{ "name": "file", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "GPX track" } } }
    },
    "/review/voyages/{file}/download": {
      "get": { "summary": "Download a voyage from the review application", "parameters": [{ "name": "file", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Voyage ZIP" } } }
    },
    "/review/charts": {
      "get": { "summary": "List Signal K chart resources used by voyage review", "responses": { "200": { "description": "Chart resources" } } }
    },
    "/settings": {
      "post": { "summary": "Update persistent automatic-recording and calculated-result recording settings", "responses": { "200": { "description": "Settings saved" } } }
    },
    "/voyage/start": {
      "post": { "summary": "Start an ordinary canonical voyage", "responses": { "200": { "description": "Voyage started" }, "400": { "description": "Start rejected" } } }
    },
    "/voyage/stop": {
      "post": { "summary": "Stop and package an ordinary voyage", "responses": { "200": { "description": "Voyage ZIP completed" }, "400": { "description": "Stop rejected" } } }
    },
    "/voyage/comment": {
      "post": { "summary": "Set the current or next voyage comment", "responses": { "200": { "description": "Comment saved" }, "400": { "description": "Comment rejected" } } }
    },
    "/voyage/observations": {
      "get": { "summary": "Return recent observations for the active voyage", "responses": { "200": { "description": "Observation status" } } },
      "post": { "summary": "Append a timestamped skipper observation", "responses": { "200": { "description": "Observation appended" }, "400": { "description": "Observation rejected" } } }
    },
    "/voyage/replay/start": {
      "post": { "summary": "Start fixed-rate replay and recomputed child recording", "responses": { "200": { "description": "Replay started" }, "400": { "description": "Replay rejected" } } }
    },
    "/voyage/playback/start": {
      "post": { "summary": "Play a completed recorded result without recording a new voyage", "responses": { "200": { "description": "Playback started" }, "400": { "description": "Playback rejected" } } }
    },
    "/voyage/playback/stop": {
      "post": { "summary": "Stop standalone playback or preserve a partial recapture", "responses": { "200": { "description": "Playback stopped" }, "400": { "description": "Stop rejected" } } }
    },
    "/voyage/player/play": {
      "post": { "summary": "Play saved results, calculate fresh results, or start a recaptured child voyage", "responses": { "200": { "description": "Player started" }, "400": { "description": "Play rejected" } } }
    },
    "/voyage/player/pause": {
      "post": { "summary": "Pause the active voyage player without advancing source time", "responses": { "200": { "description": "Player paused" }, "400": { "description": "Pause rejected" } } }
    },
    "/voyage/player/resume": {
      "post": { "summary": "Resume paused voyage playback", "responses": { "200": { "description": "Player resumed" }, "400": { "description": "Resume rejected" } } }
    },
    "/voyage/player/rewind": {
      "post": { "summary": "Return a non-recording playback to the beginning", "responses": { "200": { "description": "Player returned to beginning" }, "400": { "description": "Rewind rejected" } } }
    },
    "/voyage/player/seek": {
      "post": { "summary": "Move non-recording playback to an elapsed source time", "responses": { "200": { "description": "Player moved" }, "400": { "description": "Seek rejected" } } }
    },
    "/voyage/replay/stop": {
      "post": { "summary": "Finalise a replay after verified canonical EOF", "responses": { "200": { "description": "Recomputed ZIP completed" }, "400": { "description": "Finalisation rejected" } } }
    },
    "/voyage/replay/abort": {
      "post": { "summary": "Interrupt replay and preserve incomplete evidence", "responses": { "200": { "description": "Incomplete ZIP completed" }, "400": { "description": "Abort rejected" } } }
    }
  }
}
